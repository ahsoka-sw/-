#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

class Node {
public:
    int value;
    int index;
    Node* left;
    Node* right;
    int l, r;
    Node(int l, int r) : l(l), r(r), left(nullptr), right(nullptr), value(0), index(0) {}
    ~Node() {
        delete left;
        delete right;
    }
};

class SegmentTree {
private:
    Node* root;
    vector<int> arr;
    Node* build(int l, int r) {
        Node* node = new Node(l, r);
        if (l == r) {
            node->value = arr[l];
            node->index = l;
            return node;
        }
        int mid = (l + r) / 2;
        node->left = build(l, mid);
        node->right = build(mid + 1, r);
        if (node->left->value > node->right->value) {
            node->value = node->left->value;
            node->index = node->left->index;
        }
        else if (node->right->value > node->left->value) {
            node->value = node->right->value;
            node->index = node->right->index;
        }
        else {
            node->value = node->left->value;
            node->index = min(node->left->index, node->right->index);
        }
        return node;
    }
    pair<int, int> max(Node* node, int ql, int qr) {
        if (ql <= node->l && node->r <= qr) 
            return {node->value, node->index};
        int mid = (node->l + node->r) / 2;
        if (qr <= mid) 
            return max(node->left, ql, qr);
        if (ql > mid) 
            return max(node->right, ql, qr);
        pair<int, int> leftRes = max(node->left, ql, qr);
        pair<int, int> rightRes = max(node->right, ql, qr);
        if (leftRes.first > rightRes.first) 
            return leftRes;
        else if (rightRes.first > leftRes.first) 
            return rightRes;
        else 
            return {leftRes.first, min(leftRes.second, rightRes.second)};
    }
    void update(Node* node, int pos, int newValue) {
        if (node->l == node->r) {
            node->value = newValue;
            return;
        }
        int mid = (node->l + node->r) / 2;
        if (pos <= mid)
            update(node->left, pos, newValue);
        else
            update(node->right, pos, newValue);
        if (node->left->value > node->right->value) {
            node->value = node->left->value;
            node->index = node->left->index;
        }
        else if (node->right->value > node->left->value) {
            node->value = node->right->value;
            node->index = node->right->index;
        }
        else {
            node->value = node->left->value;
            node->index = min(node->left->index, node->right->index);
        }
    }
public:
    SegmentTree(vector<int>& a) {
        arr = a;
        root = build(0, a.size() - 1);
    }
    ~SegmentTree() {
        delete root;
    }
    pair<int, int> max(int l, int r) {
        return max(root, l, r);
    }
    void update(int pos, int newValue) {
        update(root, pos, newValue);
    }
};

int main() {
    int n;
    cin >> n;
    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    SegmentTree st(arr);
    int m;
    cin >> m;
    for (int i = 0; i < m; i++) {
        char s;
        cin >> s;
        if (s == 's') {
            int l, r;
            cin >> l >> r;
            pair<int, int> res = st.max(l - 1, r - 1);
            cout << res.second + 1 << ' ';
        }
        else if (s == 'u') {
            int pos, newValue;
            cin >> pos >> newValue;
            st.update(pos - 1, newValue);
        }
    }
}
