#include <iostream>
#include <vector>
using namespace std;

class MaxHeap {
private:
    vector<int> heap; 
    void moveUp(int i) {
        while (i > 0) {
            int parent = (i - 1) / 2; 
            if (heap[parent] < heap[i]) {
                swap(heap[parent], heap[i]);
                i = parent;
            } 
            else 
                break;
        }
    }
    void moveDown(int i) {
        int n = heap.size();
        int largest = i;
        int left = 2 * i + 1;
        int right = 2 * i + 2;
        if (left < n && heap[left] > heap[largest])
            largest = left;
        if (right < n && heap[right] > heap[largest])
            largest = right;
        if (largest != i) {
            swap(heap[i], heap[largest]);
            moveDown(largest);
    }
}

public:
    void insert(int value) {
        heap.push_back(value);
        moveUp(heap.size() - 1);
    }
    int extract() {
        int maxVal = heap[0];
        heap[0] = heap.back(); 
        heap.pop_back();
        if (!heap.empty()) 
            moveDown(0);
        return maxVal;
    }
};

int main() {
    int N;
    cin >> N;
    MaxHeap myHeap;
    for (int i = 0; i < N; ++i) {
        int command;
        cin >> command;
        if (command == 0) {
            int k;
            cin >> k;
            myHeap.insert(k);
        } 
        else if (command == 1) 
            cout << myHeap.extract() << endl;
    }
}
