#include <iostream>
#include <string>
#include <vector>
#include <queue>
using namespace std;

struct Node {
    bool is_end;
    Node* children[26];
    Node() : is_end(false) {
        for (int i = 0; i < 26; ++i) {
            children[i] = nullptr;
        }
    }
    ~Node() {
        for (int i = 0; i < 26; ++i) {
            delete children[i];
        }
    }
};

class Trie {
private:
    Node* root;
public:
    Trie() { 
        root = new Node();
    }
    ~Trie() { 
        delete root; 
    }
    void insert(const string& word) {
        Node* cur = root;
        for (char c : word) {
            int idx = c - 'a';
            if (!cur->children[idx]) 
                cur->children[idx] = new Node();
            cur = cur->children[idx];
        }
        cur->is_end = true;
    }
    string get_winning_alphabet(const string& word) {
        bool adj[26][26] = {false};
        Node* cur = root;
        for (char c : word) {
            if (cur->is_end) 
                return "nemoguce";
            int target_idx = c - 'a';
            for (int i = 0; i < 26; ++i) {
                if (cur->children[i] && i != target_idx) 
                    adj[target_idx][i] = true;
            }
            cur = cur->children[target_idx];
        }
        int in_degree[26] = {0};
        for (int i = 0; i < 26; ++i) {
            for (int j = 0; j < 26; ++j) {
                if (adj[i][j]) 
                    in_degree[j]++;
            }
        }
        queue<int> q;
        for (int i = 0; i < 26; ++i) {
            if (in_degree[i] == 0) 
                q.push(i);
        }
        string result = "";
        while (!q.empty()) {
            int u = q.front();
            q.pop();
            result += 'a' + u;
            for (int v = 0; v < 26; ++v) {
                if (adj[u][v]) {
                    in_degree[v]--;
                    if (in_degree[v] == 0) 
                        q.push(v);
                }
            }
        }
        if (result.length() < 26) 
            return "nemoguce";
        return result;
    }
};

int main() {
    int n;
    cin >> n;
    vector<string> teams(n);
    Trie trie;
    for (int i = 0; i < n; ++i) {
        cin >> teams[i];
        trie.insert(teams[i]);
    }
    for (int i = 0; i < n; ++i) {
        cout << trie.get_winning_alphabet(teams[i]) << endl;
    }
}
